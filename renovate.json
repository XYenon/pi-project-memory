{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":automergeStableNonMajor",
    ":configMigration",
    "customManagers:biomeVersions"
  ],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "description": "Automerge non-major updates for tree-sitter packages, which are still 0.x",
      "matchPackageNames": ["tree-sitter", "tree-sitter-bash"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
